{
  "name": "teambuilding-workflow-dashboard",
  "version": "0.11.4",
  "private": true,
  "description": "江湖有旅人内容生产、分发与流量转化本地工作台",
  "main": "desktop/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron desktop/main.js",
    "dist:portable": "node node_modules/electron-builder/out/cli/cli.js --win portable",
    "test": "node --test path-security.test.js material-scanner.test.js lib/dedup-ledger.test.js lib/distribution-data.test.js lib/transfer-progress.test.js lib/image-generation.test.js lib/production-recipes.test.js public/distribution-ui.test.js public/material-workspace.test.js public/workbench-ui.test.js",
    "mcp:juguang": "node mcp/juguang-mcp.js",
    "check:juguang": "node -e \"const d=require('./lib/juguang-data').getJuguangSnapshot(); console.log(JSON.stringify({mode:d.mode,counts:d.counts,recommendations:d.recommendations.length},null,2))\""
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jianghuyoulvren.teambuilding.workbench",
    "productName": "团建工作台",
    "asar": false,
    "files": [
      "desktop/**/*",
      "integrations/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "directories": {
      "output": "../releases/0.11.4"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "团建工作台-${version}-便携版.exe"
    }
  },
  "dependencies": {
    "sharp": "^0.34.5"
  }
}
